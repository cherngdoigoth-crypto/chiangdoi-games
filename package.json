{
  "name": "chiangdoi-games-26-score",
  "private": true,
  "version": "1.0.0",
  "description": "ระบบบริหารคะแนนการแข่งขันกีฬาเชิงดอยเกมส์ ครั้งที่ 26 ประจำปีงบประมาณ 2570 (React + Google Apps Script + Google Sheets)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:gas": "tsc --noEmit -p server/tsconfig.json && node scripts/build-gas.mjs",
    "push:gas": "npm run build:gas && cd server/dist && clasp push -f",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run",
    "preview": "vite preview",
    "dev:api": "esbuild server/src/devServer.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/dev-api.mjs && node node_modules/.cache/dev-api.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@google/clasp": "3.4.1",
    "@types/google-apps-script": "2.0.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.1",
    "esbuild": "0.28.2",
    "postcss": "8.5.30",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}